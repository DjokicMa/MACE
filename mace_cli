try:
    from mace.utils import ui
    UI_AVAILABLE = True
except Exception:
    UI_AVAILABLE = False

# When the ui facade can't be imported (e.g. running mace_cli outside the
# installed package), fall back to a minimal stdlib shim so every ``ui.*`` call
# site below stays guard-free. The shim mirrors the facade's *plain* mode:
# markup is stripped, warn/err go to stderr, progress is a no-op pass-through.
if not UI_AVAILABLE:
    import re as _re

    class _UIShim:
        # Mirror ui.py _MARKUP_TOKEN: strip [/...] close tags (incl. bare [/]) and
        # [word]/[#hex] open tags, but PRESERVE bracketed data ([OK], [Errno 2],
        # [1, 2, 3]). The old r"\[/?[^\[\]]*\]" over-stripped that data.
        _MARKUP = _re.compile(r"\[/[^\[\]]*\]|\[[a-z#][^\[\]]*\]")

        def _plain(self, text):
            return self._MARKUP.sub("", str(text))

        def ok(self, msg):
            print(self._plain(msg))

        def info(self, msg):
            print(self._plain(msg))

        def print(self, *objects, **kwargs):
            file = kwargs.pop("file", sys.stdout)
            for k in ("style", "markup", "highlight", "justify"):
                kwargs.pop(k, None)
            cleaned = [self._plain(o) if isinstance(o, str) else o for o in objects]
            print(*cleaned, file=file, **kwargs)

        def warn(self, msg):
            print(self._plain(msg), file=sys.stderr)

        def err(self, msg):
            print(self._plain(msg), file=sys.stderr)

        def rule(self, title=""):
            title = self._plain(title)
            if title:
                print(f"-- {title} " + "-" * max(3, 74 - len(title)))
            else:
                print("-" * 80)

        def table(self, columns, rows, *, title=None):
            cols = [str(c) for c in columns]
            str_rows = [[self._plain(str(c)) for c in r] for r in rows]
            widths = [len(c) for c in cols]
            for r in str_rows:
                for i, cell in enumerate(r):
                    if i < len(widths):
                        widths[i] = max(widths[i], len(cell))
            if title:
                print(self._plain(str(title)))
            print("  ".join(c.ljust(widths[i]) for i, c in enumerate(cols)))
            print("  ".join("-" * w for w in widths))
            for r in str_rows:
                print("  ".join(
                    (r[i] if i < len(r) else "").ljust(widths[i])
                    for i in range(len(cols))
                ))

        def progress(self, iterable, **kwargs):
            return iterable

        def badge(self, state):
            return str(state).upper()

        # banner/credits: the shim only activates when the real ui facade failed
        # to import. show_banner() prefers UI_AVAILABLE; keep these as safe
        # fallbacks so that path never raises AttributeError. banner() concise,
        # credits() defers to banner.py when present.
        def banner(self, version, **kwargs):
            if os.environ.get("MACE_NO_BANNER", "").lower() in ("1", "true", "yes"):
                return
            print(f"MACE v{version} - Mendoza Automated CRYSTAL Engine")

        def credits(self):
            try:
                from mace.utils.banner import get_credits
                print(get_credits())
            except Exception:
                print("\n" + "=" * 60)
                print("Developed at Michigan State University")
                print("Mendoza Group - Materials Science & Engineering")
                print("=" * 60)

    ui = _UIShim()
    UI_AVAILABLE = True

# Theme choices for --theme: derive from the ui facade so they never drift from
