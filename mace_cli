        sys.argv.append('--no-banner')

    def command_args(command_name):
        """Arguments following the command on the ORIGINAL command line.

        args.args + remaining loses flag/value pairing (positionals get
        pulled ahead of unknown options, so `mace submit --exclude-nodes n1
        file.d12` arrives scrambled), and submodule parsers don't define
